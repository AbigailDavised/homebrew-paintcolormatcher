const args = process.argv.slice(2);

if (args.includes('--version') || args.includes('-v')) {
  console.log('paintcolormatcher-cli v1.0.0 (https://paintcolormatcher.com)');
  process.exit(0);
}

if (args.includes('--routes')) {
  console.log(JSON.stringify({ domain: 'paintcolormatcher.com', endpoints: ROUTES }, null, 2));
  process.exit(0);
}

if (args.includes('--specs') || args.includes('--json')) {
  console.log(JSON.stringify({ domain: 'paintcolormatcher.com', benchmark: "CIEDE2000 Perceptual Tolerance & Light Reflectance Value (LRV) Thresholds", rows: SPECS }, null, 2));
  process.exit(0);
}

